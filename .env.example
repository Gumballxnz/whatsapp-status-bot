# Google Cloud Console — OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID="SEU_GOOGLE_CLIENT_ID_AQUI"
GOOGLE_CLIENT_SECRET="SEU_GOOGLE_CLIENT_SECRET_AQUI"
GOOGLE_REFRESH_TOKEN="SEU_GOOGLE_REFRESH_TOKEN_AQUI"

# Número do Dono/Administrador (apenas números: DDI + DDD + número)
OWNER_NUMBER="258XXXXXXXXX"

# Agendador Cron diário (exemplo: todo dia às 09:00 -> "0 9 * * *")
STATUS_CRON="0 9 * * *"

# Fuso horário para agendamento e cálculo de dias
TIMEZONE="Africa/Maputo"

# Data base de início para contagem de dias (DAY X)
START_DATE="2026-01-01"

# Caminho para o arquivo de mídia a ser postado (vídeo .mp4 ou imagem .jpg/.png)
MEDIA_PATH="./video.mp4"
